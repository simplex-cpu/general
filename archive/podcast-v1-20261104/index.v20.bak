const MON=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const fmtD=s=>{const d=new Date(s+"T00:00:00Z");return d.getUTCDate()+" "+MON[d.getUTCMonth()]};
const dayDiff=(a,b)=>Math.round((new Date(a+"T00:00:00Z")-new Date(b+"T00:00:00Z"))/864e5);
const clean=s=>String(s||"").replace(/⚡/g,"").trim().toLowerCase();
const plain=v=>v==null?null:Array.isArray(v)?plain(v[0]):typeof v==="object"?(v.name??(v.valuesByLinkedRecordId?plain(Object.values(v.valuesByLinkedRecordId).flat()):null)):v;
const median=a=>{const s=a.filter(x=>x!=null).sort((x,y)=>x-y);return s.length?(s.length%2?s[(s.length-1)/2]:(s[s.length/2-1]+s[s.length/2])/2):null};
function idOf(name){const c=clean(name);if(!c)return null;if(ALIAS[c])return ALIAS[c];
  const e=EP.find(x=>clean(x.n)===c);if(e)return e.id;return Object.keys(B).find(id=>B[id].n&&clean(B[id].n)===c)||null}
let ASOF="views to 24 Oct 2026, production to 26 Oct 2026";

async function fetchLive(){
  if(window.claude?.use){
    const mcp=await window.claude.use("mcp");
    if(!mcp)throw {code:"unavailable"};
    const out={};
    await Promise.all(Object.entries(LIVE).map(async([key,[tbl,f]])=>{
      let recs=[],cursor=null;
      do{const r=await mcp.callTool("Airtable","list_records_for_table",{baseId:BASE,tableId:tbl,fieldIds:Object.values(f),pageSize:1000,...(LIVEQ[key]||{}),...(cursor?{cursor}:{})},{cache:false});
        const p=r.payload||{};recs=recs.concat(p.records||[]);cursor=ONCE.has(key)?null:(p.nextCursor||null)}while(cursor);
      out[key]=recs.map(x=>Object.assign({_rid:x.id},x.cellValuesByFieldId||{}))}));
    LIVEX.at=new Date().toISOString();return out}
  const r=await fetch(location.pathname.replace(/\/$/,"")+"/data",{cache:"no-store"});
  if(!r.ok)throw {code:"http_"+r.status};
  const j=await r.json();LIVEX.at=j.fetchedAt||null;return fromRest(j)}
function fromRest(j){const out={};for(const key in LIVE)out[key]=(j[key]||[]).map(x=>Object.assign({_rid:x.id},x.fields||{}));return out}
