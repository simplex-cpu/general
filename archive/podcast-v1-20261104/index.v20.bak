const ONCE=new Set(["daily"]);
const ALIAS={"kash solo episode 1":"solo","kash solo: vedic laws":"solo","dr tamanna c (episode 2)":"tam2","mitesh and indu khatri":"mitesh","ebrahim turner (episode 2)":"ebr2","francesca tighinean (episode 2)":"fra2"};
