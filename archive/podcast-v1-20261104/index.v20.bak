 zen:{after:154,since:"24 Aug",first:"19 Oct",days:56,step:1,before:134,s:[17685,24846,25568,25933,26322,26550,26808,26942,27096],flag:0,acts:[[8,"Test 1"]]}
};
const STEPS=["Thumbnail test","Title test","Both together","Ads boost","Content push"];
const gains=s=>s.map((v,i)=>i?v-s[i-1]:v);
function LIFT(){const r=REC.lalitaa;if(!r||!r.acts.length)return null;const g=gains(r.s),w=r.acts[0][0];if(!(w>0&&g[w-1]>0&&g[w]!=null))return null;return {from:g[w-1],to:g[w],x:f1(g[w]/g[w-1]).replace(/\.0$/,"")}}
const shortN=n=>n.replace(/^Dr /,"").split(" ")[0];
function testStats(){
  const ids=Object.keys(REC),days=ids.filter(i=>REC[i].since!=="Added by you").map(i=>REC[i].days).sort((a,b)=>a-b),med=days[Math.floor(days.length/2)];
  const t=ids.filter(i=>REC[i].first&&REC[i].since!=="Added by you"&&REC[i].after!=null&&REC[i].before),pc=i=>Math.round((REC[i].after/REC[i].before-1)*100);
  const up=t.filter(i=>REC[i].after>REC[i].before),dn=t.filter(i=>REC[i].after<=REC[i].before),fmt=i=>`${shortN(B[i].n)} ${pc(i)>=0?"+":""}${pc(i)}%`;
  const L=LIFT(),lift=L?`${k(L.from)} to ${k(L.to)} views a week`:null;
  const res=LIVEX.results?`${LIVEX.results} ${LIVEX.results===1?"has":"have"} a logged result`:"none has a logged result";
  const line=`A median of ${med} days from falling below pace to the first test. The ${t.length} tests started on 19 Oct are ${LIVEX.daysIn} days in and ${res}. In the first test week, views went up on ${up.length}${up.length?` (${up.map(fmt).join(", ")})`:""} and down on ${dn.length}${dn.length?` (${dn.map(fmt).join(", ")})`:""}.${L?` Your thumbnail change on Lalitaa lifted views ${L.x}× (${k(L.from)} → ${k(L.to)} a week).`:""}`;
  return {med,n:t.length,line,lift,status:`${LIVEX.daysIn} days in, ${res}; views in test week 1 up on ${up.map(fmt).join(", ")||"none"}, down on ${dn.map(fmt).join(", ")||"none"}`};
}
const series=id=>REC[id]?REC[id].s:FULL[id]||null;
function recChart(id){
  const sr=series(id);
  if(!sr){const e=EP.find(x=>x.id===id)||B[id];return `<div class="emptychart">Weekly views start on release day${e&&e.rel?" ("+e.rel+")":""}.</div>`}
  const r=REC[id]||{flag:null,acts:[]},g=gains(sr),n=g.length+1,W=460,H=150,L=36,R=8,T=16,Bm=22,max=Math.max(...g)*1.1;
  const bw=(W-L-R)/n,y=v=>T+(1-v/max)*(H-T-Bm);
  let o=[0,max/2].map(v=>`<line x1="${L}" x2="${W-R}" y1="${y(v)}" y2="${y(v)}" stroke="${css("--line")}"/><text x="${L-6}" y="${y(v)+4}" text-anchor="end" font-size="10" fill="${css("--muted")}">${k(Math.round(v))}</text>`).join("");
  o+=g.map((v,i)=>`<rect x="${L+i*bw+1}" y="${y(v)}" width="${Math.max(2,bw-2)}" height="${H-Bm-y(v)}" rx="1" fill="${css("--grey-line")}"/>`).join("");
  if(r.flag!=null)o+=`<line x1="${L+r.flag*bw}" x2="${L+r.flag*bw}" y1="${T}" y2="${H-Bm}" stroke="${css("--act")}" stroke-dasharray="3 3"/><text x="${L+r.flag*bw+3}" y="${T-4}" font-size="10" fill="${css("--act")}">below pace</text>`;
  o+=r.acts.map(([w,l])=>`<line x1="${L+w*bw+bw/2}" x2="${L+w*bw+bw/2}" y1="${T+10}" y2="${H-Bm}" stroke="${css("--accent")}" stroke-width="2"/><text x="${Math.min(L+w*bw+bw/2,W-R-4)}" y="${H-6}" text-anchor="${w>n-4?"end":"middle"}" font-size="10" font-weight="600" fill="${css("--accent")}">${l}</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Views gained per week, with actions marked">${o}</svg>${r.lift?`<p class="pm" style="margin-top:4px">${r.lift}.</p>`:""}`;
}
function recovery(){
  const ids=Object.keys(REC),days=ids.filter(i=>REC[i].since!=="Added by you").map(i=>REC[i].days).sort((a,b)=>a-b),med=days[Math.floor(days.length/2)];
  const running=ids.filter(i=>REC[i].first).length;
  $("reckpis").innerHTML=`
   <div class="kpi"><span class="lab">Time to react</span><span class="val big" style="color:var(--act)">${med} days</span><span class="sub">Median from falling below pace to first test. Target <b>3 days</b></span></div>
   <div class="kpi"><span class="lab">Below pace with a test running</span><span class="val big">${running} of ${ids.length}</span><span class="sub">Ebrahim has no test</span></div>
   <div class="kpi"><span class="lab">Tests with a result</span><span class="val big">${LIVEX.results} of ${running}</span><span class="sub">${LIVEX.daysIn} days in · views up on <b>${ids.filter(i=>REC[i].first&&REC[i].after!=null&&REC[i].after>REC[i].before).length}</b>, down on <b>${ids.filter(i=>REC[i].first&&REC[i].after!=null&&REC[i].after<=REC[i].before).length}</b></span></div>
   <div class="kpi"><span class="lab">Best measured lift</span><span class="val big" style="color:var(--ok)">${(LIFT()||{x:"–"}).x}×</span><span class="sub">Lalitaa, after your thumbnail change</span></div>`;
  $("ladder").innerHTML=`<b>Playbook</b>`+STEPS.map((s,i)=>`<span class="step"><i>${i+1}</i>${s}</span>`).join(" → ")+`<span>· Root cause sets the first step: few clicks → 1, low reach → 4, viewers leave early → 5 · next step if no lift after 7 days</span>`;
  const rows=ids.sort((a,b)=>(REC[a].first?1:0)-(REC[b].first?1:0)||REC[b].days-REC[a].days);
  $("rectbl").innerHTML=`<thead><tr><th>Episode</th><th>Root cause</th><th>Below pace since</th><th>First action</th><th>Days to react</th><th>Playbook step</th><th>Views a week, last 12</th><th>Week before test</th><th>Test week 1</th></tr></thead><tbody>${rows.map(id=>{const r=REC[id],e=EP.find(x=>x.id===id),g=gains(r.s).slice(-12),mx=Math.max(...g);
    return `<tr class="click" data-brief="${id}"><td><b>${e.n}</b></td><td>${(V=>V[0]?`<span class="dgc st ${V[0]}">${V[1]}</span>`:`<span class="pend">${V[1]}</span>`)(VERD[verdict(id)])}</td><td>${r.since}</td><td>${r.first?r.first+(r.by?" (you)":""):`<span class="react bad">None</span>`}</td><td><span class="react ${r.days<=3?"good":"bad"}">${r.days}${r.first?"":"+"}</span></td><td><span class="dots">${STEPS.map((_,i)=>`<i class="${i<r.step-1?"on":i===r.step-1?"now":""}"></i>`).join("")}</span> <span class="pm">${r.step?r.step+". "+STEPS[r.step-1]:"Start "+({reach:4,content:5}[verdict(id)]||1)+". "+STEPS[({reach:4,content:5}[verdict(id)]||1)-1]}</span></td><td><span class="bars">${g.map(v=>`<i style="height:${Math.max(2,v/mx*22)}px"></i>`).join("")}</span></td><td class="num">${r.before!=null&&r.first?k(r.before)+"/wk":"–"}</td><td class="num">${r.after!=null?`${k(r.after)}/wk<br><span class="${r.after>=r.before?"react good":"react bad"}" style="font-weight:500">${r.after>=r.before?"+":""}${Math.round((r.after/r.before-1)*100)}%</span>`:`<span class="pend">${r.first?"Starts Monday":"–"}</span>`}</td></tr>`}).join("")}</tbody>`;
}

let adding=false;
function addRow(){
  const opts=EP.filter(e=>!REC[e.id]&&series(e.id));
  $("addrow").innerHTML=adding?`<select class="addsel" id="addSel" aria-label="Episode to add">${opts.map(e=>`<option value="${e.id}">${e.n}</option>`).join("")}</select><button class="addbtn" type="button" id="addGo">Add to testing</button><button class="x" type="button" id="addCancel">Cancel</button>`:`<button class="addbtn" type="button" id="addOpen">+ Add episode to testing</button>`;
  if(adding){$("addGo").onclick=()=>{const id=$("addSel").value,sr=series(id),e=EP.find(x=>x.id===id);REC[id]={since:"Added by you",first:"24 Oct",by:"you",days:0,step:1,before:e.wk,s:sr,flag:null,acts:[[sr.length,"Test 1"]]};
      B[id]={...B[id],st:"watch",lane:"stalled",step:"Thumbnail test",owner:"CJ",when:"Start by 27 Oct",soon:1,going:"Added to testing by you on 24 Oct.",you:["Approve 3 thumbnail options"],them:["Brief Jean for 3 thumbnails","Start the test by Monday","Report CTR after 3 days"]};NEED[id]="Approve 3 thumbnails";
      adding=false;addRow();recovery();strip();pipeline();kpis()};
    $("addCancel").onclick=()=>{adding=false;addRow()}}
  else $("addOpen").onclick=()=>{adding=true;addRow()};
}
function homeLine(){const c={act:0,watch:0};Object.values(B).forEach(b=>{if(c[b.st]!=null)c[b.st]++});$("homeLine").innerHTML=`<span class="st s-act">${c.act} act</span> <span class="st s-watch">${c.watch} watch</span> · Marc behind pace`}
homeLine();
kpis();strip();$("askOpen").onclick=()=>openPeek("works");picker();compare();addRow();recovery();pipeline();team();

