<title>ReLearn CEO View</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap">
<style>
/* Layout: 4 sections in Kash's reading order: Overview (KPIs + status cards) → Comparison (picker, 5 KPIs, chart, sortable table) → Production pipeline (runway + board, 3 stacked tags) → Team brief (Recognise / Coach / Watchlist). Status colours are the only colours that mean something: Act red, Watch amber, Leave alone green. Signal blue = selected. */
:root{
  --bg:#F3F4F6; --panel:#FFFFFF; --ink:#16181D; --muted:#69707B; --line:#E2E4E9; --soft:#EEF0F3;
  --accent:#2350C9; --accent-soft:#E3EAFB;
  --act:#B42B2B; --act-soft:#F8DEDC; --watch:#9A6200; --watch-soft:#F8EBCB; --ok:#1D7A43; --ok-soft:#DDF1E4;
  --grey-line:#C9CDD5;
  --f-body:"Public Sans","Helvetica Neue",Arial,system-ui,sans-serif;
  --f-display:var(--f-body); --f-data:var(--f-body);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#111317; --panel:#1A1D23; --ink:#EDEEF1; --muted:#9AA0AB; --line:#2B2F37; --soft:#22262D;
  --accent:#7FA2FF; --accent-soft:#1F2A47;
  --act:#FF8A80; --act-soft:#3F1D1B; --watch:#F0C062; --watch-soft:#3A2E12; --ok:#6FD39A; --ok-soft:#173324;
  --grey-line:#3D424C; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#111317; --panel:#1A1D23; --ink:#EDEEF1; --muted:#9AA0AB; --line:#2B2F37; --soft:#22262D;
  --accent:#7FA2FF; --accent-soft:#1F2A47;
  --act:#FF8A80; --act-soft:#3F1D1B; --watch:#F0C062; --watch-soft:#3A2E12; --ok:#6FD39A; --ok-soft:#173324;
  --grey-line:#3D424C; color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:14px;line-height:1.45;margin:0;font-variant-numeric:tabular-nums}
.wrap{max-width:1600px;margin:0 auto;padding-block:18px 60px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
@media (min-width:900px){.wrap{padding-left:max(32px,env(safe-area-inset-left,0px));padding-right:max(32px,env(safe-area-inset-right,0px))}}
h1,h2,h3{font-family:var(--f-body);font-weight:600;letter-spacing:-.005em;text-wrap:balance;margin:0}
.num{font-family:var(--f-data);font-variant-numeric:tabular-nums}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
ul{margin:0;padding-left:18px}
li{margin-bottom:3px}

.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}
.brand{font-size:14px;font-weight:600;display:flex;gap:8px;align-items:center}
.onair{width:9px;height:9px;border-radius:50%;background:var(--act);box-shadow:0 0 0 3px var(--act-soft)}
.asof{font-size:12px;color:var(--muted)}
.asof.live{color:var(--ok)}.asof.warn{color:var(--act)}
.topr{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.refresh{all:unset;cursor:pointer;font-size:12px;font-weight:600;padding:5px 12px;border:1px solid var(--line);border-radius:999px;background:var(--panel)}
.refresh:hover{border-color:var(--ink)}.refresh[disabled]{opacity:.55;cursor:default}
.tabs{display:flex;gap:2px;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:18px;scrollbar-width:none}
.tab{all:unset;cursor:pointer;padding:10px 14px;font-size:14px;color:var(--muted);border-bottom:2px solid transparent;white-space:nowrap}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--ink);font-weight:600}
.tab[disabled]{cursor:default;opacity:.45}
.jump{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:22px}
.jump a{font-size:13px;color:var(--muted);text-decoration:none;padding:4px 10px;border:1px solid var(--line);border-radius:999px;background:var(--panel)}
.jump a:hover{color:var(--ink)}

section{margin-bottom:64px;scroll-margin-top:12px}
.sh{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:12px;flex-wrap:wrap}
.sh h2{font-size:17px}
.sh .r{display:flex;gap:6px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--muted)}

/* status language */
.st{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;padding:1px 7px;border-radius:999px;white-space:nowrap;letter-spacing:.02em}
.st::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
.s-act{color:var(--act);background:var(--act-soft)} .s-watch{color:var(--watch);background:var(--watch-soft)} .s-ok{color:var(--ok);background:var(--ok-soft)}
.tagx{display:inline-block;font-size:11.5px;padding:2px 8px;border-radius:6px;background:var(--soft);color:var(--ink);white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}
.tagx.late{background:var(--act-soft);color:var(--act);font-weight:600} .tagx.soon{background:var(--watch-soft);color:var(--watch);font-weight:600}

/* KPI row */
.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:28px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:grid;gap:3px;min-width:0}
.kpi .lab{font-size:12px;color:var(--muted);font-weight:500}
.kpi .val{font-size:19px;font-weight:600;line-height:1.2}
.kpi .sub{font-size:12.5px;color:var(--muted)}
.kpi .sub b{font-weight:600;color:var(--ink)}
.kpi .big{font-size:24px}

/* status cards row */
.filters{display:flex;gap:6px}
.fb{all:unset;cursor:pointer;font-size:12px;padding:3px 9px;border-radius:999px;border:1px solid var(--line);background:var(--panel);color:var(--muted)}
.fb[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.strip{position:relative;display:flex;gap:6px;overflow-x:auto;padding-bottom:6px}
.sc{all:unset;box-sizing:border-box;flex:0 0 calc((100% - 110px)/11);cursor:pointer;border-radius:8px;padding:7px 8px;display:grid;gap:3px;align-content:start;border:1px solid transparent;min-height:78px;min-width:92px;scroll-snap-align:start}
.sc.act{background:var(--act-soft)} .sc.watch{background:var(--watch-soft)} .sc.ok{background:var(--ok-soft)}
.sc[aria-expanded="true"]{border-color:var(--ink)}
.railnote{font-size:12px;color:var(--muted)}
.sc .n{font-weight:600;font-size:12px;line-height:1.2}
.sc .h{display:flex;justify-content:space-between;align-items:center;gap:4px}
.sc .h .st{font-size:10px;padding:0 5px;gap:4px}
.sc .h .st::before{width:5px;height:5px}
.sc .h .d{white-space:nowrap;font-size:10px}
.sc.today{flex:0 0 auto;background:transparent;border:0;border-left:2px dashed var(--grey-line);border-radius:0;min-width:0;padding:6px 0 0 6px;cursor:default;font-size:10.5px;color:var(--muted);font-weight:600}
.sc .d{font-size:10.5px;color:var(--muted)}
.sc .w{font-size:11px;color:var(--muted);line-height:1.3}
.brief{background:var(--panel);border:1px solid var(--line);border-radius:12px;margin-top:10px;font-size:13px}
.bhead{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line)}
.bhead b{font-size:14px;font-weight:600}
.bhead span{color:var(--muted);font-size:12px;margin-left:8px}
.bgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
.bgrid>div{padding:12px 16px;border-left:1px solid var(--line)}
.bgrid>div:first-child{border-left:0}
.bgrid h3{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:6px}
.bgrid p{margin:0}
.bgrid ul{padding-left:16px}
.bgrid .you h3{color:var(--accent)}
.x{all:unset;cursor:pointer;color:var(--muted);font-size:12px}

/* comparison */
.pickrow{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.blink{width:10px;height:10px;border-radius:50%;flex:none}
.blink.act{background:var(--act)} .blink.watch{background:var(--watch)} .blink.ok{background:var(--ok)}
@media (prefers-reduced-motion:no-preference){.blink{animation:pulse 1.6s ease-in-out infinite}}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 currentColor;opacity:1}50%{opacity:.45}}
.picker{font-family:var(--f-body);font-size:14px;font-weight:600;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:6px 34px 6px 12px;appearance:none;-webkit-appearance:none;cursor:pointer;max-width:100%;
  background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 20px) 55%,calc(100% - 14px) 55%;background-size:6px 6px;background-repeat:no-repeat}
.pickmeta{font-size:13px;color:var(--muted)}
.five{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:16px}
.fk{background:var(--panel);padding:12px 16px;display:grid;gap:2px;align-content:start;min-width:0}
.fk .pend{color:var(--muted)}
.fk span{font-size:12px;color:var(--muted)}
.fk b{font-weight:600;font-size:20px;line-height:1.25}
.fk.g b{color:var(--ok)} .fk.r b{color:var(--act)}
.fk i{font-style:normal;font-size:12px;color:var(--muted)}
.fk i.pmk{font-weight:600}.fk.g i.pmk{color:var(--ok)}.fk.r i.pmk{color:var(--act)}
.fk i em{font-style:normal;color:var(--ink);font-weight:600}
.chart{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:16px}
.chart svg{width:100%;height:auto;display:block;overflow:visible}
.racelg{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-bottom:6px}.racelg span{display:inline-flex;align-items:center;gap:6px}.racelg i{display:inline-block;width:16px;height:0;border-top:2px solid var(--accent)}.racelg i.p{border-top:2px dashed var(--ink)}.racelg i.o{border-top:2px solid var(--grey-line)}.racelg i.c{border-top:2px dashed var(--act)}.racelg .eseg{margin-left:auto}
.rtip{position:absolute;top:44px;pointer-events:none;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-size:12px;box-shadow:0 6px 18px rgba(0,0,0,.12);min-width:180px;z-index:2}.rtip b{display:block;font-size:12.5px;margin-bottom:3px}.rtip div{display:flex;justify-content:space-between;gap:14px;color:var(--muted)}.rtip div span:last-child{color:var(--ink);font-weight:600}
.tbl{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:800px;font-size:13px}
th{font-size:12px;font-weight:600;color:var(--muted);text-align:right;padding:0;border-bottom:1px solid var(--line);white-space:nowrap}
th button{all:unset;cursor:pointer;display:block;padding:10px 12px;text-align:inherit}
th button:hover{color:var(--ink)}
th[aria-sort="ascending"] button::after{content:" ↑"} th[aria-sort="descending"] button::after{content:" ↓"}
th:first-child,td:first-child{text-align:left}
td{padding:8px 12px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
tr.sel td{background:var(--accent-soft)}
.exp{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:8px;font-weight:600}
.exp i{font-style:normal;color:var(--muted);width:12px;display:inline-block;transition:transform .15s}
.exp[aria-expanded="true"] i{transform:rotate(90deg)}
.exp small{font-weight:400;color:var(--muted);font-family:var(--f-data);font-size:11px}
.v{font-family:var(--f-data);font-variant-numeric:tabular-nums;padding:2px 7px;border-radius:6px;display:inline-block;min-width:44px;text-align:right}
.tbl th:nth-child(2),.tbl td:nth-child(2){text-align:left}
.tbl tbody tr:not(.clips):hover td{background:var(--bg)}.tbl tbody tr.sel:hover td{background:var(--accent-soft)}
.tbl td{padding:9px 12px}
.v.g{background:var(--ok-soft);color:var(--ok)} .v.r{background:var(--act-soft);color:var(--act)} .v.p{color:var(--muted)}
.rk{font-family:var(--f-data);font-size:11px;color:var(--muted);margin-left:4px;display:inline-block;min-width:24px;text-align:left}
tr.clips td{background:var(--soft);padding:10px 14px 14px 36px;text-align:left;white-space:normal}
.cliphead{font-size:13px;color:var(--muted);margin-bottom:6px}
.cliphead b{color:var(--ink);font-family:var(--f-data);font-weight:500}
table.ct{min-width:0;width:auto;font-size:13px}
table.ct th,table.ct td{padding:4px 14px 4px 0;border:0;background:transparent}
table.ct th{font-weight:500}

/* pipeline */
.runway{display:grid;grid-template-columns:repeat(11,minmax(84px,1fr));gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:12px}
.wk{border-radius:10px;padding:9px 10px;min-width:84px;border:1px solid transparent}
.wk.ok{background:var(--ok-soft)} .wk.watch{background:var(--watch-soft)} .wk.act{background:var(--act-soft)}
.wk b{display:block;font-family:var(--f-data);font-weight:500;font-size:11px;color:var(--muted)}
.wk span{display:block;font-size:13px;font-weight:600;line-height:1.2;margin-top:3px}
.legend{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font-size:12.5px;color:var(--muted);margin-bottom:8px}
.board{display:grid;grid-template-columns:repeat(5,minmax(178px,1fr));gap:10px;overflow-x:auto;padding-bottom:6px}
.lane{background:var(--soft);border-radius:14px;padding:10px;display:grid;align-content:start;gap:6px;min-width:178px}
.lane h3{font-size:13.5px;display:flex;justify-content:space-between;padding:2px 4px 4px}
.lane h3 span{font-family:var(--f-data);font-weight:400;color:var(--muted);font-size:12px}
.card{all:unset;box-sizing:border-box;cursor:pointer;background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--line);border-radius:10px;padding:8px 10px;display:grid;gap:5px;width:100%}
.card.act{border-left-color:var(--act)} .card.watch{border-left-color:var(--watch)} .card.ok{border-left-color:var(--ok)}
.card:hover{border-color:var(--grey-line)}
.card .t{display:flex;justify-content:space-between;gap:6px;font-weight:600;font-size:12.5px;line-height:1.25}
.card .t span{font-family:var(--f-data);font-weight:400;font-size:11px;color:var(--muted);white-space:nowrap}
.pl{font-size:12px;color:var(--muted);line-height:1.4}
.pl .lt{color:var(--act);font-weight:600}

/* team */
.team{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.tcol{display:grid;gap:8px;align-content:start}
.tcol h3{font-size:14px;display:flex;gap:8px;align-items:center;padding:0 2px}
.tcol h3 small{font-family:var(--f-body);font-weight:400;color:var(--muted);font-size:12px}
.pc{all:unset;box-sizing:border-box;cursor:pointer;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;align-items:center}
.pc[aria-expanded="true"]{border-color:var(--ink)}
.pc .nm b{font-size:14px;display:block}
.pc .nm span{font-size:12px;color:var(--muted)}
.score{font-size:19px;font-weight:600;text-align:right;line-height:1}
.score small{font-size:11px;color:var(--muted)}
.split{grid-column:1/-1;display:flex;gap:3px;height:6px;border-radius:999px;overflow:hidden;background:var(--soft)}
.split i{display:block;height:100%}
.pcfoot{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--muted)}
.trend{font-size:11.5px;font-weight:600;padding:2px 8px;border-radius:999px}
.t-up{color:var(--ok);background:var(--ok-soft)} .t-flat{color:var(--watch);background:var(--watch-soft)} .t-down{color:var(--act);background:var(--act-soft)}
.pdet{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-top:12px;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) minmax(0,1fr);gap:18px}
.pdet h3{font-size:12px;font-family:var(--f-body);font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:6px}
.kl{display:grid;gap:6px;font-size:13px}
.kl div{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:10px;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:5px}
.kl em{font-style:normal;font-family:var(--f-data);font-size:12px;color:var(--muted)}
.kl b{font-weight:600;font-size:13px}
.pdet p{margin:0;font-size:13px}
.you2{background:var(--accent-soft);border-radius:10px;padding:10px 12px}
.you2 h3{color:var(--accent)}
.coach{all:unset;cursor:pointer;margin-top:12px;display:inline-flex;gap:6px;align-items:center;font-size:13px;font-weight:600;background:var(--ink);color:var(--bg);padding:7px 14px;border-radius:999px}
.note{margin-top:10px;background:var(--soft);border-radius:10px;padding:12px;font-size:13px;white-space:pre-line}
.copy{all:unset;cursor:pointer;font-size:12.5px;font-weight:600;color:var(--accent);margin-top:6px;display:inline-block}
.ex{font-size:11px;color:var(--watch);background:var(--watch-soft);padding:2px 8px;border-radius:999px}

/* side peek */
.scrim{position:fixed;inset:0;background:rgba(10,12,16,.38);z-index:40}
.peek{position:fixed;top:0;right:0;bottom:0;width:min(520px,100%);background:var(--panel);border-left:1px solid var(--line);z-index:41;overflow-y:auto;box-shadow:-16px 0 40px rgba(0,0,0,.14);
  padding-top:calc(18px + env(safe-area-inset-top,0px));padding-bottom:calc(28px + env(safe-area-inset-bottom,0px));padding-left:24px;padding-right:max(24px,env(safe-area-inset-right,0px))}
.pclose{all:unset;cursor:pointer;float:right;font-size:12.5px;color:var(--muted);padding:4px 8px;border:1px solid var(--line);border-radius:999px}
.ph{display:grid;gap:6px;justify-items:start;padding-bottom:20px;border-bottom:1px solid var(--line)}
.ph h2{font-size:18px}
.pm{font-size:12.5px;color:var(--muted)}
.pblock{padding:22px 0;border-bottom:1px solid var(--line);font-size:13.5px}
.pblock:last-child{border-bottom:0}
.pblock h3{font-size:13.5px;font-weight:700;color:var(--ink);margin-bottom:8px;letter-spacing:0}
.pblock p{margin:0}
.pblock ul{padding-left:16px}

.pblock svg{width:100%;height:auto;display:block}
.pblock.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.mstats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.ms{background:var(--soft);border-radius:8px;padding:7px 8px;display:grid;gap:1px;border-top:3px solid transparent;min-width:0}
.ms.g{border-top-color:var(--ok)} .ms.r{border-top-color:var(--act)}
.ms span{font-size:10.5px;color:var(--muted)}
.ms b{font-size:15px;font-weight:600}
.ms i{font-style:normal;font-size:10.5px;color:var(--muted)}
.ms i em{font-style:normal;color:var(--ink);font-weight:600}
.ms .pend{color:var(--muted)}
.emptychart{background:var(--soft);border-radius:8px;padding:28px 12px;text-align:center;font-size:12.5px;color:var(--muted)}
.addrow{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.addbtn{all:unset;cursor:pointer;font-size:12.5px;font-weight:600;color:var(--accent);border:1px solid var(--accent);border-radius:999px;padding:4px 12px}
.addsel{font:inherit;font-size:12.5px;padding:4px 8px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--ink)}

/* recovery */
.ladder{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:12px;font-size:12px;color:var(--muted)}
.ladder b{font-weight:600;color:var(--ink);margin-right:4px}
.step{background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:3px 10px;color:var(--ink)}
.step i{font-style:normal;color:var(--muted);margin-right:4px}
.dots{display:inline-flex;gap:3px;vertical-align:middle}
.dots i{width:9px;height:9px;border-radius:50%;background:var(--soft);border:1px solid var(--grey-line)}
.dots i.on{background:var(--accent);border-color:var(--accent)}
.dots i.now{background:transparent;border:2px solid var(--accent)}
.bars{display:inline-flex;gap:2px;align-items:flex-end;height:22px;vertical-align:middle}
.bars i{width:5px;background:var(--grey-line);border-radius:1px}
.bars i.mk{background:var(--accent)}
#rectbl th{padding:10px 12px}
#rectbl th:first-child,#rectbl td:first-child{padding-left:16px}
.react{font-weight:600}
.react.bad{color:var(--act)} .react.good{color:var(--ok)}
.pend{color:var(--muted)}
tr.click{cursor:pointer}
tr.click:hover td{background:var(--soft)}
.planbar{display:inline-block;width:46px;height:5px;border-radius:999px;background:var(--soft);vertical-align:middle;margin-right:6px;overflow:hidden}
.planbar i{display:block;height:100%;background:var(--act)}

/* diagnosis */
.dg{display:grid;gap:10px}
.dgv{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.dgv .st{font-size:11.5px}
.dgv span.why{font-size:13px}
.checks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}
.ck{background:var(--soft);border-radius:8px;padding:7px 8px;display:grid;gap:1px}
.ck span{font-size:10.5px;color:var(--muted)}
.ck b{font-size:15px;font-weight:600}
.ck i{font-style:normal;font-size:10.5px}
.ck i.up{color:var(--ok)} .ck i.dn{color:var(--act)} .ck i.eq{color:var(--muted)}
.srcbar{display:flex;height:10px;border-radius:999px;overflow:hidden;margin:4px 0 6px}
.srcbar i{display:block;height:100%}
.srcleg{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:11.5px;color:var(--muted)}
.srcleg span::before{content:"";display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:4px;background:var(--c)}
.terms{display:flex;flex-wrap:wrap;gap:6px}
.terms span{font-size:12px;background:var(--soft);border-radius:999px;padding:3px 10px}
.exchip{font-size:10px;font-weight:600;color:var(--watch);background:var(--watch-soft);padding:1px 7px;border-radius:999px;margin-left:6px;letter-spacing:0;text-transform:none}
.dgc{font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;white-space:nowrap}
.works{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:28px}
.wcard{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:grid;gap:8px;align-content:start;font-size:13px}
.wcard h3{font-size:12px;color:var(--muted);font-weight:500}
.wcard .big2{font-size:17px;font-weight:600;line-height:1.25}
.wrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}
.wbar{grid-column:1/-1;height:5px;background:var(--soft);border-radius:999px;overflow:hidden}
.wbar i{display:block;height:100%;background:var(--accent)}
.wsub{font-size:12px;color:var(--muted)}
@media (max-width:960px){.works{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.works{grid-template-columns:1fr}}

.need-act{color:var(--act);font-weight:500}
.need-ok{color:var(--ok);font-weight:500}

.clink{color:var(--accent);font-weight:600;text-decoration:none}
.clink:hover{text-decoration:underline}

/* assistant */
.askrow{margin-top:24px}
.ask{all:unset;box-sizing:border-box;cursor:pointer;width:100%;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px;align-items:center;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 18px}
.ask:hover{border-color:var(--grey-line)}
.ask>span:first-child{width:32px;height:32px;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-size:15px}
.ask b{display:block;font-size:14px}
.ask small{display:block;font-size:12.5px;color:var(--muted)}
.ask .arr{color:var(--muted)}
.sugs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.sug{all:unset;cursor:pointer;font-size:12.5px;padding:5px 10px;border-radius:999px;background:var(--soft)}
.sug:hover{background:var(--accent-soft);color:var(--accent)}
.askform{display:flex;gap:8px}
.askin{flex:1;min-width:0;font:inherit;font-size:13.5px;padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:var(--panel);color:var(--ink)}
.answer{margin-top:12px;background:var(--soft);border-radius:10px;padding:12px 14px;font-size:13.5px;white-space:pre-wrap}

/* home */
.hub{display:grid;gap:10px}
.hubrow{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:grid;grid-template-columns:140px minmax(0,1fr) auto;gap:14px;align-items:center}
.hubrow b{font-family:var(--f-display);font-size:15px}
.hubrow.ghost{border-style:dashed;background:transparent;color:var(--muted)}
.linkbtn{all:unset;cursor:pointer;font-size:13px;font-weight:600;color:var(--accent)}
.hello{font-size:22px;margin-bottom:16px}

@media (max-width:960px){
  .kpis{grid-template-columns:repeat(2,minmax(0,1fr))}
  .five{grid-template-columns:repeat(4,minmax(0,1fr))}.five .fk:last-child{grid-column:span 2}
  .bgrid{grid-template-columns:repeat(2,minmax(0,1fr))}.bgrid>div:nth-child(3){border-left:0}.bgrid>div:nth-child(n+3){border-top:1px solid var(--line)}
  .team,.pdet{grid-template-columns:1fr}
}
@media (max-width:560px){
  .five{grid-template-columns:repeat(2,minmax(0,1fr))}.five .fk:last-child{grid-column:span 2}
  .bgrid{grid-template-columns:1fr}.bgrid>div{border-left:0;border-top:1px solid var(--line)}.bgrid>div:first-child{border-top:0}
  .hubrow{grid-template-columns:1fr}
  
}
</style>

