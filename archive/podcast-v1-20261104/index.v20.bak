      <div class="sh"><h2>Episodes overview</h2></div>
      <div class="kpis" id="kpis"></div>
      <div class="strip" id="strip"></div>
      <div class="askrow"><button class="ask" type="button" id="askOpen"><span>✦</span><span><b>What's working</b><small>Ask your assistant · weekly brief and follow-up questions</small></span><span class="arr">→</span></button></div>
      
    </section>

    <section id="comparison">
      <div class="sh"><h2>Episodes comparison</h2><span class="r">Ranked against every episode at the same age</span></div>
      <div class="pickrow"><span class="blink" id="blink" aria-hidden="true"></span><label for="picker" class="pickmeta" style="position:absolute;left:-9999px">Episode</label><select id="picker" class="picker"></select><span class="pickmeta" id="pickmeta"></span></div>
      <div class="five" id="five"></div>
      <div class="chart" id="raceBox" style="position:relative"><div class="racelg" id="raceLg"></div><svg id="race" role="img" aria-label="Views to date by day since release"></svg><div class="rtip" id="raceTip" hidden></div></div>
      <div class="tbl"><table id="tbl"></table></div>
    </section>

    </div>
