      <button class="sub" role="tab" type="button" data-sub="overview" aria-selected="true">Overview</button>
      <button class="sub" role="tab" type="button" disabled>Guest booking<small>Next</small></button>
      <button class="sub" role="tab" type="button" disabled>Pre-release testing<small>Next</small></button>
      <button class="sub" role="tab" type="button" disabled>Pre-release clips<small>Next</small></button>
      <button class="sub" role="tab" type="button" data-sub="release" aria-selected="false">Release</button>
      <button class="sub" role="tab" type="button" data-sub="post" aria-selected="false">Post-release</button>
    </nav>
    <div id="s-overview">
