const SNAPDAY=fmtD(String(SNAP.fetchedAt).slice(0,10));

function applyLive(D){
  const row=(key,f)=>{const m=LIVE[key][1],o={};for(const k in m)o[k]=plain(f[m[k]]);return o};
  let asof=null;
  /* lifetime numbers + diagnosis */
  for(const f of D.perf){const r=row("perf",f);if(!r.n)continue;
    let id=idOf(r.n),e=EP.find(x=>x.id===id);
    if(!e&&r.rel&&r.rel<=TODAY){
      if(!id)id=clean(r.n).replace(/[^a-z0-9]+/g,"");
      e={id,n:B[id]?.n||r.n.replace(/⚡/g,"").trim(),rel:fmtD(r.rel),d7:null,d14:null,d30:null,now:null,wk:null,clip:null,s:[]};EP.push(e);ORDER.push(id);
      if(!B[id])B[id]={st:"watch",lane:"launch",step:"First-week check",owner:"CJ",when:"Day 7",going:`Released ${fmtD(r.rel)}. New since this page was last written.`,you:["Nothing yet"],them:["Track it against the day-7 pace"]};
      B[id].n=e.n;B[id].rel=e.rel;DATE[id]=r.rel;NEED[id]=NEED[id]||"Nothing yet"}
    if(!e)continue;
    for(const k of ["d7","d14","d30","now"])if(typeof r[k]==="number"&&!(r[k]===0&&(!r.rel||r.rel>TODAY)))e[k]=r[k];
    if(typeof r.ctr==="number")DIAG[e.id]=Object.assign(DIAG[e.id]||{},{ctr:Math.round(r.ctr*1e4)/100,impr:+((r.impr||0)/1e6).toFixed(2),viewed:+((r.viewed||0)*100).toFixed(1)});
    if(r.asof&&(!asof||r.asof>asof))asof=r.asof}
  /* weekly series */
  const W={};
  for(const f of D.weekly){const r=row("weekly",f),m=/^(.*?)\s+[–-]\s+week\s+(\d+)/i.exec(r.n||"");if(!m)continue;const id=idOf(m[1]);if(!id)continue;(W[id]=W[id]||[]).push({w:+m[2],of:r.wk,to:r.to,g:r.gain});
    if(r.wk&&typeof r.to==="number"){const end=new Date(Date.parse(r.wk+"T00:00:00Z")+5*864e5).toISOString().slice(0,10);if(end<=TODAY&&(!asof||end>asof))asof=end}}
  for(const [id,rows] of Object.entries(W)){
    rows.sort((a,b)=>a.w-b.w);let run=0;const cum=rows.map(x=>run=typeof x.to==="number"?x.to:run+(x.g||0));
    const e=EP.find(x=>x.id===id);if(e){e.s=cum.slice(0,8);e.wk=rows[rows.length-1].g??e.wk;
      /* the weekly table is fresher than Daily Episode Stats: never show a total below the latest weekly total */
      const lt=rows[rows.length-1].to;if(typeof lt==="number"&&lt>(e.now||0))e.now=lt}
    if(REC[id])REC[id].s=cum;else FULL[id]=cum;
    W[id]=rows}
  /* tests */
  const T={};
  for(const f of D.tests){const r=row("tests",f),m=/^(.*?)\s+[–-]\s+test/i.exec(r.n||"");if(!m)continue;const id=idOf(m[1]);if(id)(T[id]=T[id]||[]).push(r)}
  let withResult=0,daysIn=0;
  for(const [id,ts] of Object.entries(T)){
    const done=ts.filter(t=>t.res||t.win).length;withResult+=done;
    const days=Math.max(...ts.map(t=>t.days||0));daysIn=Math.max(daysIn,days);
    const by=/by you/.test(TESTS[id]?.[1]||"")?"1 by you, ":"";
    TESTS[id]=[ts.length+(by?1:0),by+(done?`${done} with a result`:`running · ${days} days`)];
    const start=ts.map(t=>t.start).filter(Boolean).sort().pop();
    if(REC[id]&&start&&W[id]){const i=W[id].findIndex(x=>x.of&&dayDiff(start,x.of)>=0&&dayDiff(start,x.of)<7);
      if(i>0&&typeof W[id][i].g==="number"){const R=REC[id];R.after=W[id][i].g;R.before=W[id][i-1].g;
        const pct=Math.round((R.after/R.before-1)*100),line=`${pct>=0?"Up":"Down"} ${Math.abs(pct)}% in the test's first week: ${k(R.after)} views vs ${k(R.before)} the week before.`;
        if(B[id]&&B[id].going)B[id].going=B[id].going.replace(/^(Up|Down) \d+% in the test's first week.*?\.(?=\s[A-Z]|$)/,line)}}}
  LIVEX.results=withResult;LIVEX.daysIn=daysIn||LIVEX.daysIn;
  const L=LIFT();if(L){REC.lalitaa.lift=`${k(L.from)} → ${k(L.to)} a week after your change`;if(B.lalitaa)B.lalitaa.going=B.lalitaa.going.replace(/lifted it [\d.]+×/,"lifted it "+L.x+"×")}
  /* medians and verdicts (2+ week old episodes) */
  const old=EP.filter(e=>e.d14!=null&&DIAG[e.id]).map(e=>DIAG[e.id]);
  MED.ctr=median(old.map(d=>d.ctr))??MED.ctr;MED.impr=median(old.map(d=>d.impr))??MED.impr;MED.viewed=median(old.map(d=>d.viewed))??MED.viewed;
  for(const e of EP){const d=DIAG[e.id];if(!d)continue;
    d.v=e.d7==null?"early":(e.wk||0)>=PACE.stalled?"ok":d.ctr/MED.ctr<=0.9?"pack":d.impr/MED.impr<=0.75?"reach":d.viewed/MED.viewed<=0.9?"content":"none"}
  /* production */
  for(const f of D.episodes){const r=row("episodes",f);if(!r.n||!r.step||!r.rel||r.rel<TODAY||/ready to release/i.test(r.step))continue;
    const m=/^(\w+)\.\s*(.*?)\s*\(([^)]+)\)/.exec(r.step);if(!m)continue;
    let id=idOf(r.n);const owner=m[3]==="Kash"?"You":m[3],step=m[2];
    const late=r.due&&r.due<TODAY,when=!r.due?"–":r.due===TODAY?"Due today":late?`${dayDiff(TODAY,r.due)}d late`:"Due "+fmtD(r.due);
    if(!id){id=clean(r.n).replace(/[^a-z0-9]+/g,"");if(B[id])continue;
      B[id]={n:r.n.replace(/⚡/g,"").trim(),rel:fmtD(r.rel),st:"ok",lane:"prod",step,owner,when,going:`New in the calendar: releases ${fmtD(r.rel)}.`,you:["Nothing"],them:[`${owner}: ${step} by ${r.due?fmtD(r.due):"–"}`]};
      DATE[id]=r.rel;NEED[id]="Nothing";STEP0[id]=m[1]}
    const b=B[id];if(!b||!["prod","clip"].includes(b.lane))continue;
    if(typeof r.post==="number"&&PLAN[id]){PLAN[id].pct=r.post;
      const dk=TEAM.find(x=>x.id==="dakshaya");if(dk&&id==="vivek"){const kr=dk.k.find(x=>/^Clips posted vs plan/.test(x[0]));if(kr)kr[1]=r.post+"%";dk.note=dk.note.replace(/Vivek is at \d+% of planned posts/,"Vivek is at "+r.post+"% of planned posts")}}
    if(STEP0[id]===m[1]){if(r.due)b.when=when;if(late){b.st="act";b.late=1}continue}
    Object.assign(b,{step,owner,when,late:late?1:0,st:late?"act":/today/i.test(when)?"watch":"ok",
      going:`Moved on to ${step.toLowerCase()} (${owner}), ${r.due?(late?"overdue since "+fmtD(r.due):"due "+fmtD(r.due)):"no due date yet"}. Releases ${fmtD(r.rel)}.`,
      them:[`${owner==="You"?"You":owner}: ${step} by ${r.due?fmtD(r.due):"–"}`],you:late?[`Ask ${owner} for a new date today`]:["Nothing"]});
    NEED[id]=late?"Chase "+owner:"Nothing";STEP0[id]=m[1]}
  /* weekly reviews */
  const R={};
  for(const f of D.reviews){const r=row("reviews",f);if(typeof r.kpi!=="number"||typeof r.beh!=="number")continue;const who=clean((r.n||"").split(/\s+[–-]\s+/)[0]);(R[who]=R[who]||[]).push(r)}
  for(const p of TEAM){const rs=(R[p.id]||R[clean(p.n)]||[]).sort((a,b)=>String(a.wk).localeCompare(String(b.wk)));if(!rs.length)continue;
    const cur=rs[rs.length-1],prev=rs[rs.length-2];p.kpi=cur.kpi;p.beh=cur.beh;p.last=prev?prev.kpi+prev.beh:null;p.real=true;p.revWk=cur.wk?fmtD(cur.wk):null}
  for(const f of D.daily||[]){const u=plain(f.fldelLjF0wxQF8kIy);if(u&&(!UPTO||u>UPTO))UPTO=u}
  const DD={};
  for(const f of D.days||[]){const r=row("days",f),m=/^(.*?)\s+[–-]\s+\d{4}-\d{2}-\d{2}$/.exec(r.key||"");if(!m||typeof r.day!=="number"||typeof r.to!=="number")continue;const id=idOf(m[1]);if(id)(DD[id]=DD[id]||[]).push([r.day,r.to])}
  for(const id in DD)DD[id].sort((a,b)=>a[0]-b[0]);
  if(Object.keys(DD).length)DAILY=DD;
  ASOF=`YouTube data up to ${UPTO?fmtD(UPTO):asof?fmtD(asof):"24 Oct"}, production live`;
  return asof}

function renderAll(){kpis();strip();picker();compare();addRow();recovery();pipeline();team();homeLine();if(peekKind)renderPeek()}
async function refreshLive(){
  const btn=$("refreshBtn"),lab=$("asof");if(LIVEX.state==="busy")return;
  LIVEX.state="busy";btn.disabled=true;btn.textContent="Refreshing…";
  try{const D=await fetchLive();/* look applyLive up after the fetch: the later scripts wrap it while the first load is in flight */const asof=applyLive(D);renderAll();
    /* say how old the data is, not when the browser asked. The hosted copy refreshes in the background when it's over 10 minutes old, so fetch again shortly */
    const t=LIVEX.at?new Date(LIVEX.at):new Date(),old=Date.now()-t.getTime()>11*60e3,tl=t.toLocaleDateString("en-CA");
    lab.textContent=`Data as of ${fmtD(tl)}, ${String(t.getHours()).padStart(2,"0")}:${String(t.getMinutes()).padStart(2,"0")}${old&&(LIVEX.tries||0)<2?" · updating…":""} · YouTube data up to ${UPTO?fmtD(UPTO):"–"}`;lab.className="asof live";
    if(old&&(LIVEX.tries||0)<2){LIVEX.tries=(LIVEX.tries||0)+1;setTimeout(refreshLive,70e3)}}
  catch(e){const c=e&&e.code;
    lab.textContent=c==="needs_reauth"?"Reconnect Airtable in Settings → Connectors":c==="server_not_connected"?"Add the Airtable connector to see live numbers":c==="selection_required"?"Choose which Airtable connector to use, then refresh":c==="not_in_manifest"||c==="approval_required"?"Allow Airtable access to refresh":c==="blocked_by_policy"?"Airtable is blocked for your account":c==="unavailable"?"Live refresh works when opened in Claude":`Couldn't refresh. Showing numbers saved ${SNAPDAY}`;
    lab.className="asof warn"}
  finally{LIVEX.state="idle";btn.disabled=false;btn.textContent="Refresh"}}
try{const a=applyLive(fromRest(SNAP));renderAll();$("asof").textContent=`Saved ${SNAPDAY}${UPTO?" · YouTube data up to "+fmtD(UPTO):""}`}catch(e){}
(()=>{const can=!!window.claude?.use||/^https?:$/.test(location.protocol);const btn=$("refreshBtn");
  if(!can){btn.hidden=true;return}btn.onclick=refreshLive;refreshLive()})();
</script>
