/* ---------- tabs ---------- */
function showTab(t){document.querySelectorAll(".tab[data-tab]").forEach(b=>b.setAttribute("aria-selected",String(b.dataset.tab===t)));$("v-home").hidden=t!=="home";$("v-podcast").hidden=t!=="podcast"}
document.addEventListener("click",e=>{const b=e.target.closest("[data-tab]");if(b&&!b.disabled){showTab(b.dataset.tab);window.scrollTo({top:0})}});
showTab(location.hash==="#home"?"home":"podcast");

/* ---------- 1. overview ---------- */
function kpis(){
  const guests=EP.filter(e=>!e.solo&&e.now!=null&&(e.d14!=null)).sort((a,b)=>b.now-a.now);
  const best=guests[0],worst=guests[guests.length-1];
  const acts=Object.values(B).filter(b=>b.st==="act").length,watch=Object.values(B).filter(b=>b.st==="watch").length;
  const withD7=EP.filter(e=>e.d7!=null&&!e.solo),last4=withD7.slice(-4),prev4=withD7.slice(-8,-4);
  const avg=a=>a.reduce((s,e)=>s+e.d7,0)/a.length,g=Math.round((avg(last4)/avg(prev4)-1)*100);
  $("kpis").innerHTML=`
   <div class="kpi"><span class="lab">Best episode ever</span><span class="val">${best.n}</span><span class="sub"><b>${k(best.now)}</b> views · released ${best.rel}</span></div>
   <div class="kpi"><span class="lab">Lowest guest episode (2+ weeks old)</span><span class="val">${worst.n}</span><span class="sub"><b>${k(worst.now)}</b> views · released ${worst.rel}</span></div>
   <div class="kpi"><span class="lab">Episodes that need you</span><span class="val big" style="color:var(--act)">${acts}</span><span class="sub">plus <b>${watch}</b> to watch</span></div>
   <div class="kpi"><span class="lab">Episode-on-episode growth</span><span class="val big" style="color:${g>=0?"var(--ok)":"var(--act)"}">${g>=0?"+":""}${g}%</span><span class="sub">Last 4 guest episodes vs the 4 before, day-7 views: <b>${k(avg(last4))}</b> vs <b>${k(avg(prev4))}</b></span></div>`;
}

let SAMPLE=null,askCtl=null;
try{const u=window.claude?.use?.("sample");if(u&&u.then)u.then(f=>{SAMPLE=f;if(peekKind==="works")renderPeek()}).catch(()=>{})}catch(e){}
const TOPICS=[["Spiritual & intuition","Tamanna, Sonia",355000],["Money & success","Ken, Ebrahim, Vishen, Regan",157000],["Relationships & psychology","Francesca, Sara, Lalitaa, Bibi",31000],["Philosophy","Zen",25300]];
function worksHTML(){
  const mx=TOPICS[0][2];
  return `<div class="ph"><h2>What's working</h2><span class="pm">Brief · 26 Oct · written from the numbers in Airtable</span></div>
   <div class="pblock"><h3>Book more spiritual and intuition guests</h3><p>Average views at day 14 by topic. Relationships episodes reach a tenth of spiritual ones.</p><div style="display:grid;gap:8px;margin-top:10px">${TOPICS.map(([t,who,v])=>`<div class="wrow"><span>${t} <span class="wsub">· ${who}</span></span><b>${k(v)}</b><div class="wbar"><i style="width:${v/mx*100}%"></i></div></div>`).join("")}</div></div>
   <div class="pblock"><h3>Day 7 decides the episode</h3><p>Every episode above 125K at day 7 reached 100K by day 30. Every one below 45K missed. Marc has ${k(EP.find(e=>e.id==="marc").now)} so far, which puts him with the ones that missed unless something changes this week.</p></div>
   <div class="pblock"><h3>Big clips don't guarantee YouTube</h3><p>2 of the 3 older episodes with a clip past 500K missed 100K. Zen's 1.55M clip led to ${k(EP.find(e=>e.id==="zen").now)} episode views.</p></div>
   <div class="pblock"><h3>Ebrahim grows the channel best</h3><p>15.2 net subscribers (gained minus lost) per 1,000 views, against 8.3 for Tamanna. Vishen 10.7, Regan 8.0.</p></div>
   <div class="pblock"><h3>Most stalled episodes aren't a thumbnail problem</h3><p>Francesca, Bibi and Sara have normal or above-median CTR but YouTube shows them to few people. A new thumbnail won't fix that; ads or clips that link to the episode might. Only Zen, Lalitaa and the solo episode have a clearly below-median CTR.</p></div>
   <div class="pblock"><h3>Testing is too slow</h3><p>${testStats().line}</p></div>
   <div class="pblock"><h3>Ask a follow-up</h3>${SAMPLE?`<div class="sugs">${["Which guests should Jade book next?","What should CJ test first on Monday?","Why are relationship episodes underperforming?"].map(q=>`<button class="sug" type="button" data-q="${q}">${q}</button>`).join("")}</div>
     <form class="askform" id="askForm"><label for="askIn" class="pm" style="position:absolute;left:-9999px">Your question</label><input id="askIn" class="askin" placeholder="Ask about any episode, topic or person" autocomplete="off"><button class="coach" type="submit" style="margin-top:0" id="askGo">Ask</button></form>
     <div class="answer" id="answer" hidden></div>`:`<p class="pm">The assistant answers when this page is opened in Claude.</p>`}</div>`;
}
function askData(){
  return JSON.stringify({asOf:ASOF,target:"100K YouTube views per episode by day 30; pace 55K at day 7, 77K at day 14",
    episodes:EP.map(e=>({name:e.n,released:e.rel,ctrLifetimePct:DIAG[e.id]?DIAG[e.id].ctr:null,impressionsLifetimeM:DIAG[e.id]?DIAG[e.id].impr:null,avgPctViewed:DIAG[e.id]?DIAG[e.id].viewed:null,diagnosis:VERD[verdict(e.id)][1],day7:e.d7,day14:e.d14,day30:e.d30,totalViews:e.now,viewsLastWeek:e.wk,bestClipViews:e.clip,clipsPosted:CLIPS[e.id]?CLIPS[e.id].n:null,thumbnailTests:TESTS[e.id]?TESTS[e.id][0]:0,status:B[e.id]?SL[B[e.id].st]:null,whatsGoingOn:B[e.id]?B[e.id].going:null})),
    topicsAvgDay14:TOPICS.map(t=>({topic:t[0],episodes:t[1],avgDay14Views:t[2]})),
    netSubscribersPer1000Views:{Ebrahim:15.2,Vishen:10.7,Tamanna:8.3,Regan:8.0},
    reactionTime:(T=>({medianDaysFromBelowPaceToFirstTest:T.med,targetDays:3,testsRunning:T.n,testStatus:T.status,lalitaaLiftAfterKashThumbnailChange:T.lift}))(testStats()),
    team:{CJ:"YouTube growth, thumbnail tests, QC",Jade:"guest booking",Dakshaya:"clips and posting",Stephen:"editing and trailers",Jean:"thumbnails"}});
}
async function ask(q){
  const out=$("answer"),go=$("askGo");if(!SAMPLE||!q.trim())return;
  out.hidden=false;out.textContent="Thinking...";go.disabled=true;
  askCtl=new AbortController();
  const prompt=`You are Kash's podcast analyst for the YouTube show "ReLearn with Kash". Kash is the CEO and wants short, direct answers he can act on.
Answer the question using ONLY the data below. Rules: at most 5 short bullet points; cite the numbers you use; name who should act (use the team list); if the data can't answer it, say exactly what data is missing. Plain text, no headings, no markdown bold.

DATA:
${askData()}

QUESTION: ${q}`;
  try{await SAMPLE(prompt,{signal:askCtl.signal,onText:({text})=>{out.textContent=text}})}
  catch(e){const msg={not_granted:"The assistant isn't allowed on this page.",sampling_disabled:"Claude isn't available on this account.",rate_limited:"Too many questions at once. Try again in a minute.",refused:"The assistant couldn't answer that. Try rephrasing.",cancelled:""}[e.code];
    if(e.code==="not_granted"||e.code==="sampling_disabled"){SAMPLE=null;renderPeek();return}
    out.textContent=(e.text?e.text+"\n\n":"")+(msg??"Something went wrong. Try again.")}
  finally{const g=$("askGo");if(g)g.disabled=false}
}
let openBrief=null;
function strip(){
  const list=Object.entries(B).sort((a,b)=>DATE[a[0]].localeCompare(DATE[b[0]]));
  let html="",marked=false;
  for(const [id,b] of list){
    if(!marked&&DATE[id]>TODAY){html+=`<div class="sc today" id="todayMark">Today</div>`;marked=true}
    html+=`<button class="sc ${b.st}" type="button" data-brief="${id}" aria-expanded="${openBrief===id}"><span class="st ${SC[b.st]}" style="justify-self:start">${{act:"Act",watch:"Watch",ok:"Leave"}[b.st]}</span><span class="d">${b.rel}</span><span class="n">${b.n}</span><span class="w">${NEED[id]}</span></button>`;
  }
  $("strip").innerHTML=html;
  const t=$("todayMark"),rail=$("strip");if(t&&!strip.done){strip.done=true;requestAnimationFrame(()=>{const kids=[...rail.children],i=kids.indexOf(t),start=kids[Math.max(0,i-3)];rail.scrollLeft=start.offsetLeft-rail.firstElementChild.offsetLeft})}
}
const li=a=>`<ul>${a.map(x=>`<li>${x}</li>`).join("")}</ul>`;
function statCells(id,cls){
  const e=EP.find(x=>x.id===id);
  const cell=(lab,key,paceKey)=>{if(!e)return `<div class="${cls}"><span>${lab}</span><b>–</b></div>`;const v=e[key],P=paceKey?PACE[paceKey]:null;
    if(v==null)return `<div class="${cls}"><span>${lab}</span><b class="pend">${e[key+"due"]||"–"}</b><i>${e[key+"due"]?"lands that day":""}</i>${P?`<i>pace ${k(P)}</i>`:""}</div>`;
    const r=rank(key,e.id),ok=P?v>=P:null;
    return `<div class="${cls} ${ok===null?"":ok?"g":"r"}"><span>${lab}</span><b>${k(v)}</b>${P?`<i class="pmk">${Math.round(v/P*100)}% of ${k(P)} pace</i>`:""}<i>Rank <em>#${r.r}</em> of ${r.of}</i></div>`};
  const ctr=()=>{const d=DIAG[id];if(!d)return `<div class="${cls}"><span>CTR</span><b class="pend">–</b><i>after 48 hours</i></div>`;const L=Object.keys(DIAG).sort((a,b)=>DIAG[b].ctr-DIAG[a].ctr),ok=d.ctr>=MED.ctr;return `<div class="${cls} ${ok?"g":"r"}"><span>CTR, lifetime</span><b>${f1(d.ctr)}%</b><i class="pmk">${Math.abs(d.ctr-MED.ctr)<0.05?"At":ok?"Above":"Below"} the ${f1(MED.ctr)}% median</i><i>Rank <em>#${1+L.filter(x=>DIAG[x].ctr>d.ctr).length}</em> of ${L.length}</i></div>`};
  const tests=()=>{const t=TESTS[id];return `<div class="${cls}"><span>Thumbnail tests</span><b>${t?t[0]:0}</b><i>${t?t[1]:"none run"}</i></div>`};
  return cell("Day 7","d7","d7")+cell("Day 14","d14","d14")+cell("Day 30","d30","d30")+cell("Total now","now")+ctr()+tests()+cell("Best clip","clip");
}
function statsHTML(id){return `<div class="mstats">${statCells(id,"ms")}</div>`}

function retentionSVG(id){
  const d=DIAG[id],W=460,H=110,L=38,R=8,T=14,Bm=20,mins=60;
  const pts=[];for(let m=0;m<=mins;m++){let v=100*Math.exp(-m/4)*0.35+(d.hold+6)*Math.exp(-m/120)*0.8+8;d.peaks.forEach(([pm])=>{v+=9*Math.exp(-((m-pm)**2)/6)});pts.push(Math.min(100,v))}
  pts[0]=100;
  const x=m=>L+m/mins*(W-L-R),y=v=>T+(1-v/100)*(H-T-Bm);
  let o=[0,50,100].map(v=>`<line x1="${L}" x2="${W-R}" y1="${y(v)}" y2="${y(v)}" stroke="${css("--line")}"/><text x="${L-5}" y="${y(v)+3}" text-anchor="end" font-size="9.5" fill="${css("--muted")}">${v}%</text>`).join("");
  o+=`<polyline points="${pts.map((v,m)=>`${x(m).toFixed(1)},${y(v).toFixed(1)}`).join(" ")}" fill="none" stroke="${css("--accent")}" stroke-width="2"/>`;
  o+=d.peaks.map(([m,l])=>`<circle cx="${x(m)}" cy="${y(pts[m])}" r="3.5" fill="${css("--accent")}"/><text x="${Math.min(Math.max(x(m),L+40),W-R-40)}" y="${y(pts[m])-7}" text-anchor="middle" font-size="9.5" font-weight="600" fill="${css("--ink")}">${l}</text>`).join("");
  o+=[0,15,30,45,60].map(m=>`<text x="${x(m)}" y="${H-5}" text-anchor="middle" font-size="9.5" fill="${css("--muted")}">${m}m</text>`).join("");
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Audience retention with peaks marked">${o}</svg>`;
}
function diagHTML(id){
  if(!DIAG[id])return `<div class="pblock"><h3>Why it's performing this way</h3><p class="pm">Shows 48 hours after release.</p></div>`;
  const d=DIAG[id];
  const ck=(lab,val,med,unit,fmt)=>{const r=val/med;const c=r>=1.1?["up","Above"]:r<=0.9?["dn","Below"]:["eq","Around"];return `<div class="ck"><span>${lab}</span><b>${fmt(val)}${unit}</b><i class="${c[0]}">${c[1]} the ${fmt(med)}${unit} median</i></div>`};
  return `<div class="pblock"><h3>Why it's performing this way</h3><div class="checks">${ck("Clicks when shown (CTR)",d.ctr,MED.ctr,"%",f1)}${ck("Times YouTube showed it",d.impr,MED.impr,"M",x=>x.toFixed(2))}${ck("Average % viewed",d.viewed,MED.viewed,"%",f1)}</div><p class="pm" style="margin-top:8px">Lifetime figures from YouTube Studio, data up to ${UPTO?fmtD(UPTO):"24 Oct"}${id==="marc"?". Too early to judge impressions":""}.</p></div>
   <div class="pblock"><h3>Coming with the YouTube connection</h3><p class="pm">Where views come from, what people search to find it, comment themes, and the moments where viewers stay or leave.</p></div>`;
}
const msgTo=b=>b.owner==="You"?"Stephen":b.owner;
const strip2=x=>x.replace(/^[A-Z][a-z]+: /,"");
function msgText(id){const b=B[id];const to=msgTo(b);return `Hi ${to}, about ${b.n} (${b.rel}):\n${b.them.filter(x=>x!=="–").map(x=>"• "+strip2(x)).join("\n")}\nThanks, Kash`}
const needCls=a=>a.every(x=>/^Nothing/.test(x))?"need-ok":"need-act";
function briefHTML(id){const b=B[id],to=msgTo(b),isEp=!!EP.find(x=>x.id===id);return `<div class="ph"><h2>${b.n}</h2><span class="pm"><span class="st ${SC[b.st]}">${SL[b.st]}</span>&nbsp; Release ${b.rel}</span></div>
 <div class="pblock two"><div><h3>What's going on</h3><p>${b.going}</p></div><div><h3>Next step</h3><p>${b.step}</p><p class="pm">${b.owner} · ${b.when}</p></div></div>
 <div class="pblock"><h3>Needed from ${b.owner==="You"?"the next owner":b.owner}</h3>${li(b.them)}</div>
 <div class="pblock"><h3>Needed from you</h3><div class="${needCls(b.you)}">${li(b.you)}</div>
 ${to&&to!=="–"?`<div style="margin-top:14px"><button class="coach" type="button" id="msgBtn" style="margin-top:0">Message ${to}</button>${msgOpen?`<div class="note" id="noteText">${msgText(id)}</div><button class="copy" type="button" id="copyBtn">Copy message</button>`:""}</div>`:""}</div>
 <div class="pblock"><h3>Numbers</h3>${statsHTML(id)}</div>
 <div class="pblock"><h3>Views gained per week</h3>${recChart(id)}</div>
 ${isEp?diagHTML(id):""}
`}
let peekKind=null,peekId=null,noteOpen=false,msgOpen=false,lastFocus=null;
function openPeek(kind,id){peekKind=kind;peekId=id;noteOpen=false;msgOpen=false;lastFocus=document.activeElement;renderPeek();$("peek").hidden=false;$("scrim").hidden=false;document.body.style.overflow="hidden";$("peek").scrollTop=0;$("peekClose").focus();if(kind==="ep"){openBrief=id;strip()}}
function closePeek(){if(askCtl)askCtl.abort();$("peek").hidden=true;$("scrim").hidden=true;document.body.style.overflow="";peekKind=null;openBrief=null;strip();if(lastFocus)lastFocus.focus()}
function renderPeek(){
  $("peekBody").innerHTML=peekKind==="ep"?briefHTML(peekId):peekKind==="p"?personHTML(peekId):peekKind==="works"?worksHTML():"";
  const af=$("askForm");if(af){af.onsubmit=e=>{e.preventDefault();ask($("askIn").value)};document.querySelectorAll(".sug").forEach(b=>b.onclick=()=>{$("askIn").value=b.dataset.q;ask(b.dataset.q)})}
  const cb=$("coachBtn");if(cb)cb.onclick=()=>{noteOpen=!noteOpen;renderPeek()};
  const mb=$("msgBtn");if(mb)mb.onclick=()=>{msgOpen=!msgOpen;renderPeek()};
  const cp=$("copyBtn");if(cp)cp.onclick=()=>{const t=$("noteText").textContent;navigator.clipboard.writeText(t).then(()=>{cp.textContent="Copied"}).catch(()=>{const r=document.createRange();r.selectNodeContents($("noteText"));const sl=getSelection();sl.removeAllRanges();sl.addRange(r);cp.textContent="Selected. Press copy"})};
}
$("peekClose").onclick=closePeek;$("scrim").onclick=closePeek;
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&!$("peek").hidden)closePeek()});
document.addEventListener("click",ev=>{const b=ev.target.closest("[data-brief]");if(b&&!b.closest(".peek"))openPeek("ep",b.dataset.brief)});

/* ---------- 2. comparison ---------- */
let sel="sonia",sortKey="rel",sortDir="desc";const openRows=new Set();
const rank=(key,id)=>{const L=EP.filter(e=>e[key]!=null),me=L.find(e=>e.id===id);return me?{r:1+L.filter(e=>e[key]>me[key]).length,of:L.length}:null};
function picker(){
  $("picker").innerHTML=[...EP].reverse().map(e=>`<option value="${e.id}" ${e.id===sel?"selected":""}>${e.n}</option>`).join("");
  $("picker").onchange=ev=>{sel=ev.target.value;compare()};
}
function compare(){
  const e=EP.find(x=>x.id===sel),b=B[sel]||{st:"ok"};
  $("picker").value=sel;
  $("blink").className="blink "+b.st;$("blink").title=SL[b.st];
  $("pickmeta").innerHTML=`${SL[b.st]} · released ${e.rel}`;
  $("five").innerHTML=statCells(e.id,"fk");
  race();table();
}
const paceAt=d=>d<=7?PACE.d7*d/7:d<=14?PACE.d7+(PACE.d14-PACE.d7)*(d-7)/7:d<=30?PACE.d14+(PACE.d30-PACE.d14)*(d-14)/16:PACE.d30+(d-30)*PACE.stalled/7;
let raceLife=false;
function race(){
  if(!Object.keys(DAILY).length)return raceWeekly();
  const svg=$("race"),box=$("raceBox"),mono='font-family="Public Sans, Arial, sans-serif"';
  const W=Math.round(svg.getBoundingClientRect().width)||1100,small=W<640,H=small?250:300,L=small?40:48,R=small?40:58,T=36,B2=26;
  const ages=Object.values(DAILY).map(a=>a.length?a[a.length-1][0]:0),maxD=raceLife?Math.max(60,...ages):60;
  const inR=a=>a.filter(([d])=>d<=maxD);
  const peak=Math.max(paceAt(maxD),...Object.values(DAILY).map(a=>Math.max(0,...inR(a).map(p=>p[1]))));
  const raw=peak*1.04,mag=10**Math.floor(Math.log10(raw/5)),stp=[1,2,2.5,5,10].map(m=>m*mag).find(z=>Math.ceil(raw/z)<=6),nL=Math.ceil(raw/stp),maxV=stp*nL;
  const x=d=>L+(d-1)/(maxD-1)*(W-L-R),y=v=>T+(1-Math.min(v,maxV)/maxV)*(H-T-B2);
  let g="";
  for(let i=0;i<=nL;i++){const v=stp*i;g+=`<line x1="${L}" x2="${W-R}" y1="${y(v)}" y2="${y(v)}" stroke="${css("--line")}"/><text x="${L-8}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="${css("--muted")}" ${mono}>${v?k(v):"0"}</text>`}
  const ticks=raceLife?[1,30,60,90,120,150,180,210,240,270,300,330,360].filter(d=>d<=maxD):[1,7,14,21,30,45,60];
  g+=ticks.map(d=>`<text x="${x(d)}" y="${H-7}" text-anchor="middle" font-size="11" fill="${css("--muted")}" ${mono}>${d===1?"Day 1":d}</text>`).join("");
  /* checkpoint marks, as on the episode's own chart */
  let lastX=-99,row=0;
  for(const [d,l] of [[1,"D1"],[3,"D3"],[7,"D7 · decide"],[14,"D14"],[30,"D30"]]){const xx=x(d);row=xx-lastX<64?(row+1)%2:0;lastX=xx;
    g+=`<line x1="${xx}" x2="${xx}" y1="${T-6+row*12}" y2="${H-B2}" stroke="${css("--act")}" stroke-opacity=".55" stroke-width="1.2" stroke-dasharray="4 4"/><text x="${xx+3}" y="${T-10+row*12}" font-size="10.5" font-weight="600" fill="${css("--act")}" ${mono}>${l}</text>`}
  const pts=a=>inR(a).map(([d,v])=>`${x(d).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
  g+=EP.filter(e=>e.id!==sel&&DAILY[e.id]).map(e=>`<polyline points="${pts(DAILY[e.id])}" fill="none" stroke="${css("--grey-line")}" stroke-width="1.2" stroke-linejoin="round"/>`).join("");
  g+=`<polyline points="${pts(Array.from({length:maxD},(_,i)=>[i+1,paceAt(i+1)]))}" fill="none" stroke="${css("--ink")}" stroke-width="1.4" stroke-dasharray="5 4"/>`;
  g+=[[7,PACE.d7],[14,PACE.d14],[30,PACE.d30]].map(([d,v])=>`<circle cx="${x(d)}" cy="${y(v)}" r="3" fill="${css("--ink")}"/><text x="${x(d)+5}" y="${y(v)-7}" font-size="10.5" font-weight="600" fill="${css("--ink")}" stroke="${css("--panel")}" stroke-width="3" paint-order="stroke" ${mono}>${k(v)}</text>`).join("");
  g+=`<text x="${W-R+6}" y="${y(paceAt(maxD))+4}" font-size="11" font-weight="600" fill="${css("--ink")}">Pace</text>`;
  const s=EP.find(e=>e.id===sel),me=inR(DAILY[sel]||[]);
  if(me.length){const last=me[me.length-1];g+=`<polyline points="${pts(me)}" fill="none" stroke="${css("--accent")}" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round"/><circle cx="${x(last[0])}" cy="${y(last[1])}" r="4.5" fill="${css("--accent")}" stroke="${css("--panel")}" stroke-width="2"/><text x="${Math.min(x(last[0])+8,W-R-30)}" y="${y(last[1])-8}" font-size="12" font-weight="600" fill="${css("--accent")}" stroke="${css("--panel")}" stroke-width="3" paint-order="stroke" ${mono}>${k(last[1])}</text>`}
  else g+=`<text x="${(L+W-R)/2}" y="${T+26}" text-anchor="middle" font-size="13" font-weight="600" fill="${css("--accent")}">${s.n}'s line starts the day after release</text>`;
  g+=`<line id="raceCur" x1="0" x2="0" y1="${T}" y2="${H-B2}" stroke="${css("--grey-line")}" visibility="hidden"/>`;
  svg.setAttribute("viewBox",`0 0 ${W} ${H}`);svg.innerHTML=g;
  $("raceLg").innerHTML=`<span><i></i>${s.n}</span><span><i class="p"></i>Pace: 55K day 7, 77K day 14, 100K day 30</span><span><i class="c"></i>Checkpoints</span><span><i class="o"></i>Other episodes</span><span>Daily views to ${UPTO?fmtD(UPTO):"–"}</span><div class="eseg" role="group" aria-label="Chart range"><button type="button" data-rl="0" aria-pressed="${!raceLife}">First 60 days</button><button type="button" data-rl="1" aria-pressed="${raceLife}">Lifetime</button></div>`;
  $("raceLg").onclick=ev=>{const b=ev.target.closest("[data-rl]");if(b){raceLife=b.dataset.rl==="1";race()}};
  const tip=$("raceTip");
  svg.onmousemove=ev=>{const r=svg.getBoundingClientRect(),sx=(ev.clientX-r.left)/r.width*W,d=Math.max(1,Math.min(maxD,Math.round((sx-L)/(W-L-R)*(maxD-1)+1)));
    const at=id=>{const p=(DAILY[id]||[]).find(q=>q[0]===d);return p?p[1]:null},v=at(sel),others=EP.map(e=>at(e.id)).filter(z=>z!=null),rk=v!=null?1+others.filter(z=>z>v).length:null;
    const c=$("raceCur");c.setAttribute("x1",x(d));c.setAttribute("x2",x(d));c.setAttribute("visibility","visible");
    tip.innerHTML=`<b>Day ${d}</b><div><span>${s.n}</span><span>${v!=null?k(v):"–"}</span></div><div><span>Pace</span><span>${k(Math.round(paceAt(d)))}</span></div><div><span>Of pace</span><span>${v!=null?Math.round(v/paceAt(d)*100)+"%":"–"}</span></div><div><span>Rank at day ${d}</span><span>${rk?"#"+rk+" of "+others.length:"–"}</span></div>`;
    tip.hidden=false;const bw=box.clientWidth,tw=tip.offsetWidth,px=x(d)/W*r.width+(r.left-box.getBoundingClientRect().left);tip.style.left=Math.max(6,Math.min(bw-tw-6,px-tw/2))+"px"};
  svg.onmouseleave=()=>{tip.hidden=true;const c=$("raceCur");if(c)c.setAttribute("visibility","hidden")};
}
addEventListener("resize",()=>{clearTimeout(race.t);race.t=setTimeout(()=>{if($("race").getBoundingClientRect().width)race()},150)});
function raceWeekly(){
  $("raceLg").innerHTML="";$("race").setAttribute("viewBox","0 0 720 280");
  const W=720,H=280,L=46,R=70,T=12,B2=28,maxW=8,maxV=500000;
  const x=w=>L+(w-1)/(maxW-1)*(W-L-R),y=v=>T+(1-Math.min(v,maxV)/maxV)*(H-T-B2);
  const mono='font-family="Public Sans, Arial, sans-serif"';
  let g=[0,100000,200000,300000,400000,500000].map(v=>`<line x1="${L}" x2="${W-R}" y1="${y(v)}" y2="${y(v)}" stroke="${css("--line")}"/><text x="${L-8}" y="${y(v)+4}" text-anchor="end" font-size="11" fill="${css("--muted")}" ${mono}>${v?k(v):"0"}</text>`).join("");
  g+=Array.from({length:maxW},(_,i)=>`<text x="${x(i+1)}" y="${H-6}" text-anchor="middle" font-size="11" fill="${css("--muted")}" ${mono}>wk ${i+1}</text>`).join("");
  g+=`<line x1="${L}" x2="${W-R}" y1="${y(100000)}" y2="${y(100000)}" stroke="${css("--ink")}" stroke-width="1.2" stroke-dasharray="5 4"/><text x="${W-R+6}" y="${y(100000)+4}" font-size="11" font-weight="600" fill="${css("--ink")}">100K</text>`;
  const line=(e,on)=>`<polyline points="${e.s.slice(0,maxW).map((v,i)=>`${x(i+1).toFixed(1)},${y(v).toFixed(1)}`).join(" ")}" fill="none" stroke="${on?css("--accent"):css("--grey-line")}" stroke-width="${on?3:1.3}" stroke-linejoin="round"/>`;
  g+=EP.filter(e=>e.s.length&&e.id!==sel).map(e=>line(e,false)).join("");
  const s=EP.find(e=>e.id===sel);
  if(s.s.length){const n=Math.min(s.s.length,maxW);g+=line(s,true)+s.s.slice(0,maxW).map((v,i)=>`<circle cx="${x(i+1)}" cy="${y(v)}" r="3.5" fill="${css("--accent")}"/>`).join("")+`<text x="${x(n)+8}" y="${y(s.s[n-1])+4}" font-size="12" font-weight="600" fill="${css("--accent")}" ${mono}>${k(s.s[n-1])}</text>`}
  else g+=`<text x="${(L+W-R)/2}" y="${T+26}" text-anchor="middle" font-size="13" font-weight="600" fill="${css("--accent")}">${s.n}'s line starts after week 1</text>`;
  $("race").innerHTML=g;
}
const COLS=[["n","Episode"],["dg","Root cause"],["d7","Day 7"],["d14","Day 14"],["d30","Day 30"],["now","Total"],["wk","Last week"],["clip","Best clip"],["clips","Clips posted"],["plan","Clips vs plan"]];
function table(){
  const val=(e,key)=>key==="rel"?ORDER.indexOf(e.id):key==="n"?e.n:key==="clips"?(CLIPS[e.id]?CLIPS[e.id].n:0):key==="plan"?(PLAN[e.id]?PLAN[e.id].pct:null):key==="dg"?({content:0,reach:1,pack:2,none:3,ok:4,early:5}[verdict(e.id)]):e[key];
  const rows=[...EP].sort((a,b)=>{const A=val(a,sortKey),Bv=val(b,sortKey);if(A==null&&Bv==null)return 0;if(A==null)return 1;if(Bv==null)return -1;const c=typeof A==="string"?A.localeCompare(Bv):A-Bv;return sortDir==="asc"?c:-c});
  const cell=(e,key)=>{const v=e[key];if(v==null)return `<span class="v p">${e[key+"due"]||"–"}</span>`;const r=rank(key,e.id);return `<span class="v ${v>=PACE[key]?"g":"r"}">${k(v)}</span><span class="rk">#${r.r}</span>`};
  const head=`<thead><tr>${COLS.map(([key,l])=>`<th ${sortKey===key?`aria-sort="${sortDir==="asc"?"ascending":"descending"}"`:""}><button type="button" data-sort="${key}">${l}</button></th>`).join("")}</tr></thead>`;
  const body=rows.map(e=>{const c=CLIPS[e.id];const open=openRows.has(e.id);
    const r=`<tr class="${e.id===sel?"sel":""}"><td><button class="exp" type="button" data-row="${e.id}" aria-expanded="${open}"><i>›</i>${e.n} <small>${e.rel}</small></button></td><td>${(V=>V[0]?`<span class="dgc st ${V[0]}">${V[1]}</span>`:`<span class="pend">${V[1]}</span>`)(VERD[verdict(e.id)])}</td><td>${cell(e,"d7")}</td><td>${cell(e,"d14")}</td><td>${cell(e,"d30")}</td><td class="num">${k(e.now)}</td><td class="num">${e.wk!=null?"+"+k(e.wk):"–"}</td><td class="num">${k(e.clip)}<span class="rk">#${rank("clip",e.id).r}</span></td><td class="num">${c?c.n:"–"}</td><td>${PLAN[e.id]?`<span class="planbar"><i style="width:${PLAN[e.id].pct}%"></i></span>${PLAN[e.id].pct}%`:`<span class="pend">No plan</span>`}</td></tr>`;
    const x=open&&c?`<tr class="clips"><td colspan="${COLS.length}"><div class="cliphead"><b>${c.n}</b> clips posted · <b>${k(c.t)}</b> total clip views · top 8 below, numbers as of 15–19 Oct${PLAN[e.id]?` · <b>${PLAN[e.id].pct}%</b> of plan: ${PLAN[e.id].txt}`:""}</div><table class="ct"><thead><tr><th>Posted</th><th>Platform</th><th>Format</th><th>Views</th><th>Shares</th><th>Saves</th><th>Link</th></tr></thead><tbody>${c.c.map(([d,p,f,v,sh,sv,url])=>`<tr><td class="num">${d}</td><td>${p==="IG"?"Instagram":"YouTube Shorts"}</td><td>${f}</td><td class="num">${k(v)}</td><td class="num">${k(sh)}</td><td class="num">${k(sv)}</td><td>${url?`<a class="clink" href="${url}" target="_blank" rel="noopener">Open ↗</a>`:"–"}</td></tr>`).join("")}</tbody></table></td></tr>`:"";
    return r+x}).join("");
  $("tbl").innerHTML=head+`<tbody>${body}</tbody>`;
}
document.addEventListener("click",ev=>{
  const s=ev.target.closest("[data-sort]");if(s){const key=s.dataset.sort;if(sortKey===key)sortDir=sortDir==="asc"?"desc":"asc";else{sortKey=key;sortDir=key==="n"?"asc":"desc"}table();return}
  const r=ev.target.closest("[data-row]");if(r){const id=r.dataset.row;openRows.has(id)?openRows.delete(id):openRows.add(id);sel=id;compare()}
});

/* ---------- 3. pipeline ---------- */
function pipeline(){
  $("runway").innerHTML=RUNWAY.map(([d,n,s])=>`<div class="wk ${s}"><b>${d}</b><span>${n}</span></div>`).join("");
  const card=id=>{const b=B[id];return `<button class="card ${b.st}" type="button" data-brief="${id}"><div class="t">${b.n}<span>${b.rel}</span></div><span class="st ${SC[b.st]}" style="justify-self:start">${SL[b.st]}</span><div class="pl">${b.step}${b.owner!=="–"?" · "+b.owner:""}<br><span class="${b.late?"lt":""}">${b.when==="–"?"No date":b.when}</span></div></button>`};
  const lane=(key,title)=>{const ids=Object.keys(B).filter(id=>B[id].lane===key).sort((a,b)=>STATUS_ORDER[B[a].st]-STATUS_ORDER[B[b].st]);return `<div class="lane"><h3>${title}<span>${ids.length}</span></h3>${ids.map(card).join("")}</div>`};
  $("board").innerHTML=lane("prod","In production")+lane("clip","Clipping")+lane("launch","First 30 days")+lane("growing","Growing")+lane("stalled","Stalled");
}


/* ---------- 4. team ---------- */
const trend=p=>{if(p.kpi==null)return ["t-flat","Not scored yet",null];if(p.last==null)return ["t-flat","First review",null];const d=p.kpi+p.beh-p.last;return d>=5?["t-up","Improving",d]:d<=-5?["t-down","Declining",d]:["t-flat","Stalled",d]};
function team(){
  $("teamcols").innerHTML=GROUPS.map(([g,l,c,sub])=>`<div class="tcol"><h3><span class="st ${c}">${l}</span><small>${sub}</small></h3>${TEAM.filter(p=>p.g===g).map(p=>{const t=trend(p),tot=p.kpi+p.beh;return `<button class="pc" type="button" data-p="${p.id}"><div class="nm"><b>${p.n}</b><span>${p.r}</span></div><div class="score">${p.kpi==null?`<span class="pend" style="font-size:13px;font-weight:500">–</span>`:`${tot}<small>/100</small>`}</div>${p.kpi==null?"":`<div class="split" aria-label="KPIs ${p.kpi} of 70, behaviour ${p.beh} of 30"><i style="width:${p.kpi}%;background:var(--accent)"></i><i style="width:${p.beh}%;background:var(--grey-line)"></i></div>`}<div class="pcfoot"><span>${p.kpi==null?"No Monday review yet":`KPIs ${p.kpi}/70 · Behaviour ${p.beh}/30`}</span><span class="trend ${t[0]}">${t[1]}${t[2]!=null?` ${t[2]>0?"+":""}${t[2]}`:""}</span></div></button>`}).join("")}</div>`).join("");
}
function personHTML(id){
  const p=TEAM.find(x=>x.id===id),t=trend(p),g=GROUPS.find(x=>x[0]===p.g);
  return `<div class="ph"><span class="st ${g[2]}">${g[1]}</span><h2>${p.n}</h2><span class="pm">${p.r} · ${p.kpi==null?"No Monday review yet":`${p.kpi+p.beh}/100 (KPIs ${p.kpi}/70, behaviour ${p.beh}/30)`}</span></div>
   <div class="pblock"><h3>${p.real?"KPIs from the "+(p.revWk||"26 Oct")+" review":"From production and testing data"}</h3><div class="kl">${p.k.map(([n,now,last])=>`<div><span>${n}</span><b>${now}</b><em>${p.real?last:"was "+last}</em></div>`).join("")}</div></div>
   <div class="pblock"><h3>What's going on</h3><p>${p.going}</p></div>
   <div class="pblock you"><h3>Needed from you</h3><div class="${needCls(p.you)}">${li(p.you)}</div></div>
   <div class="pblock"><button class="coach" type="button" id="coachBtn" style="margin-top:0">✦ ${noteOpen?"Hide":"Draft"} coaching note</button>${noteOpen?`<div class="note" id="noteText">${p.note}</div><button class="copy" type="button" id="copyBtn">Copy note</button>`:""}</div>`;
}
document.addEventListener("click",ev=>{const p=ev.target.closest("[data-p]");if(p)openPeek("p",p.dataset.p)});

/* ---------- 3b. recovery ---------- */
const FULL={tamanna:[133443,321978,371148,398484,428855,447615,477931,496731,509181,520271,533418,543329,559335,583645,597349,606974,625444,656701,688934,718197,755165],
 ken:[127788,218390,250102,289371,317462,354997,385155,408692,425098,443896,469827,491436,516780,549455,605588,664271,709971,753737],
 vishen:[78299,159156,199554,226033,247398,265372,283596,296923,309740,337853,358654,376325],
 sonia:[99890,321819,384101,443919],
 solo:[1176,5225,6550,6881,7131,7301,7455,7608,7728,7869,8065,8417,8825,9117,9348]};

const REC={
 ebrahim:{since:"6 Jul",first:null,days:112,step:0,before:7083,s:[108886,161015,206389,230372,245484,259356,265005,271705,276477,282652,291612,304134,317981,332408,346499,359301,368425,381284,388367,396773],flag:4,acts:[]},
 regan:{after:9886,since:"25 May",first:"19 Oct",days:147,step:1,before:7010,s:[5160,15812,40290,54417,67256,76599,79047,81208,82332,83134,83799,84815,85792,87614,91343,116488,146029,166112,179324,192219,199229,209089],flag:0,acts:[[21,"Test 1"]]},
 francesca:{after:930,since:"29 Jun",first:"19 Oct",days:112,step:1,before:1128,s:[26671,56332,65705,68418,72252,75810,79239,81668,84630,87577,92735,102910,107005,108829,110779,112240,113593,114721,115648],flag:2,acts:[[18,"Test 1"]]},
 lalitaa:{after:380,since:"29 Jun",first:"13 Jul",by:"you",days:14,step:2,before:472,s:[1653,7221,35793,49649,55641,57948,61673,66367,86510,110233,124177,141435,156520,165048,166955,167427,167806],flag:0,acts:[[2,"Your change"],[16,"Test 2"]],lift:"5.6K → 28.6K a week after your change"},
 bibi:{after:66,since:"6 Jul",first:"19 Oct",days:105,step:1,before:104,s:[1593,8978,14942,17963,19446,19757,19934,20037,20126,20356,20531,20802,20927,21049,21153,21217],flag:0,acts:[[15,"Test 1"]]},
